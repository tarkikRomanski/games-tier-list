# Optional: free RAWG API key from https://rawg.io/apidocs (500k+ games).
# Without it the app falls back to FreeToGame (no key needed, free-to-play titles only).
RAWG_API_KEY=

# Database. Leave empty locally to use a SQLite file at DATABASE_PATH.
# On Vercel set these to a Turso database (https://turso.tech):
#   DATABASE_URL=libsql://<your-db>-<your-org>.turso.io
#   DATABASE_AUTH_TOKEN=<token from `turso db tokens create <your-db>`>
DATABASE_URL=
DATABASE_AUTH_TOKEN=
DATABASE_PATH=./data/tierlist.db

# Optional: Sign in with Google. Create an OAuth client (type "Web application") at
# https://console.cloud.google.com/apis/credentials and add the redirect URI
# http://localhost:5173/api/auth/google/callback (plus your production domain's equivalent).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Public origin used to build the redirect URI, if it differs from the request's host.
# PUBLIC_URL=https://tiers.example.com

# Port for the API server (and the whole app with `npm start`).
PORT=3001

# Session cookies are marked Secure in production. Set to false if you serve over plain http.
# SECURE_COOKIES=true
